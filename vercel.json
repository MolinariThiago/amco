{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://amco-production.up.railway.app/api/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/admin(.*)",
      "status": 302,
      "headers": {
        "Location": "https://molaris-production-be0c.up.railway.app/admin$1"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
