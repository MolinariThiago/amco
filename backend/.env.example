# ─────────────────────────────────────────────
#  AMCO — Variables de entorno
#  Copiá este archivo a .env y completá los datos
# ─────────────────────────────────────────────

# Puerto del servidor (default: 3000)
PORT=3000

# URL pública del sitio (para links en los mails)
SITE_URL=http://localhost:3000

# CORS — dominio autorizado en producción (ej: https://amco.com.ar)
# Usar * solo en desarrollo local
ALLOWED_ORIGIN=*

# ── Seguridad ──────────────────────────────────
# Secreto para firmar tokens JWT (OBLIGATORIO cambiar en producción)
JWT_SECRET=amco_jwt_super_secret_changeme_2026

# Pepper para hasheo de contraseñas (OBLIGATORIO cambiar en producción)
PASS_PEPPER=amco_pepper_changeme_2026

# ── Email (Nodemailer) ─────────────────────────
# Configuración para Gmail con App Password:
#   1. Activar verificación en 2 pasos en tu cuenta Google
#   2. Ir a Cuenta Google → Seguridad → Contraseñas de aplicación
#   3. Generar contraseña para "Mail" y pegarla en SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Email de la clínica que recibe notificaciones de turnos
# (además de franchomolinari72@gmail.com que siempre recibe copia)
CLINIC_EMAIL=turnos@amco.com.ar
