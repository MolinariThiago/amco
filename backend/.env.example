# ─────────────────────────────────────────────────────────────────
#  AMCO — Variables de entorno
#  Copiá este archivo a .env y completá los datos
# ─────────────────────────────────────────────────────────────────

PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────
# Railway: se setea automáticamente al conectar el plugin PostgreSQL
# Local: postgresql://usuario:contraseña@localhost:5432/amco_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/amco_db

# SSL para PostgreSQL en producción (Railway = true)
DB_SSL=false

# ── CORS ─────────────────────────────────────────────────────────
# URL del frontend (ej: https://amco.vercel.app). En dev usar: *
ALLOWED_ORIGIN=https://amcoodontologia.com.ar

# ── Seguridad ─────────────────────────────────────────────────────
# Secreto para firmar tokens JWT (OBLIGATORIO cambiar en producción)
JWT_SECRET=amco_jwt_super_secret_changeme_2026

# Pepper para hasheo de contraseñas (OBLIGATORIO cambiar en producción)
PASS_PEPPER=amco_pepper_changeme_2026
